{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
